rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function validOrder(orderId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id',
          'customerName',
          'phone',
          'city',
          'address',
          'paymentMethod',
          'transactionId',
          'items',
          'totalAmount',
          'status',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'customerName',
          'phone',
          'city',
          'address',
          'paymentMethod',
          'transactionId',
          'items',
          'totalAmount',
          'status',
          'createdAt'
        ])
        && data.id == orderId
        && data.customerName is string
        && data.customerName.size() > 0
        && data.customerName.size() <= 120
        && data.phone is string
        && data.phone.size() > 0
        && data.phone.size() <= 32
        && data.city is string
        && data.city.size() > 0
        && data.city.size() <= 100
        && data.address is string
        && data.address.size() > 0
        && data.address.size() <= 500
        && data.paymentMethod in ['cod', 'meezan', 'easypaisa']
        && data.transactionId is string
        && data.transactionId.size() <= 120
        && (data.paymentMethod == 'cod'
          ? data.transactionId == ''
          : data.transactionId.size() > 0)
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 30
        && data.totalAmount is number
        && data.totalAmount > 0
        && data.status == 'Pending'
        && data.createdAt is int;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /artifacts/{appId}/public/data/orders/{orderId} {
      allow create: if validOrder(orderId);
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in [
          'Pending',
          'Packed',
          'Dispatched',
          'Delivered',
          'Cancelled'
        ];
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
